# Copy this file to .env.local and fill in your key(s). .env.local is gitignored
# by the Next.js default template — never commit real keys.

# Required for the photo-scan feature (src/app/api/analyze-tag/route.ts and the
# other analyze-* routes) — this is the "paid"/fallback key in the two-key setup
# below. Get a key at https://aistudio.google.com/apikey (Google AI Studio); it's
# free by default (no cost) until a billing account is linked to its project.
GEMINI_API_KEY=

# Optional: a SECOND key, on a SEPARATE Google Cloud project with no billing
# account linked. See src/lib/geminiClient.ts — every vision call tries this key
# first and only falls back to GEMINI_API_KEY on failure (rate limit, quota
# exhausted, or any other error). Rate limits and free/paid billing status are
# per PROJECT, not per key — a second key on the SAME project as GEMINI_API_KEY
# shares that project's quota and billing, so this only works as a real "free
# tier first, then paid" setup if the two keys are genuinely on two different
# projects (create the free one via "New project" in AI Studio's project
# picker, or in Google Cloud Console directly, and don't link it to billing).
# Omit this var entirely to just use GEMINI_API_KEY for everything.
GEMINI_API_KEY_FREE=

# Optional: override the model (default: gemini-3.5-flash-lite). gemini-2.5-flash
# 404s on new API keys - they're provisioned on the newer Interactions API.
# GEMINI_MODEL=gemini-3.5-flash-lite
#
# Picked Flash-Lite specifically for its free-tier daily quota: 500 RPD vs.
# 20 RPD on gemini-3.6-flash (confirmed in the AI Studio console at
# https://aistudio.google.com/rate-limit — numbers vary by project tier, so
# check yours there before assuming). Not viable alone for real multi-user
# traffic — pair it with GEMINI_API_KEY_FREE above, or enable billing on
# GEMINI_API_KEY's own project directly. Either way, Flash-tier vision requests
# are a small fraction of a cent each once billing is in the picture.
