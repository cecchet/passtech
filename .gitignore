# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# rulebook PDF/text/HTML reference cache — large binaries, not application code, kept locally
# only as a research convenience (see rulebooks/README.md, which stays tracked)
rulebooks/*
!rulebooks/README.md
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# personal test photos used to exercise the photo-scan feature, not project source
/Safety gear tags/

# typescript
*.tsbuildinfo
next-env.d.ts
