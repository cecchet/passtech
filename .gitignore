# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# personal test photos used to exercise the photo-scan feature, not project source
/Safety gear tags/

# local research cache of third-party copyrighted rulebook/homologation-list PDFs -- not
# referenced by app code (see src/data/fiaHomologation/*.json for the runtime data these
# were used to hand-derive), kept locally only, not for public redistribution
/rulebooks/
/fia-lists/

# typescript
*.tsbuildinfo
next-env.d.ts
